# NanoPC-T4 (RK3399) board fragment on top of arch/arm64/configs/defconfig
# Applied with scripts/kconfig/merge_config.sh -m

# Identifiable kernel release / hostname
CONFIG_LOCALVERSION="-nanopc-t4"
CONFIG_DEFAULT_HOSTNAME="nanopc-t4"

# Keep the boot path built in (SD/eMMC already =y in defconfig), so
# root-on-NVMe / NFS-root does not depend on the initramfs
CONFIG_PCIE_ROCKCHIP_HOST=y
CONFIG_PHY_ROCKCHIP_PCIE=y
CONFIG_NVME_CORE=y
CONFIG_BLK_DEV_NVME=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y

# Board extras that defconfig leaves out (all as modules)
CONFIG_PHY_ROCKCHIP_DP=m
CONFIG_ZRAM=m
CONFIG_F2FS_FS=m
CONFIG_XFS_FS=m
CONFIG_NTFS3_FS=m
CONFIG_EXFAT_FS=m
CONFIG_NLS_UTF8=m
CONFIG_DM_CRYPT=m
CONFIG_DM_VERITY=m

# netfilter / nftables: needed by tailscale (and iptables compatibility).
# NF_TABLES itself stays a module; the inet/ipv4/ipv6/netdev table families are
# bools and are compiled into nf_tables.ko.
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NF_TABLES_NETDEV=y
CONFIG_NF_NAT=m
CONFIG_NF_CONNTRACK=m
CONFIG_NFT_CT=m
CONFIG_NFT_NAT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_REDIR=m
CONFIG_NFT_COUNTER=m

# classic iptables (iptables-legacy); iptables-nft only needs the above
CONFIG_NETFILTER_XTABLES=m
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=m
CONFIG_IP_NF_IPTABLES_LEGACY=m
CONFIG_IP_NF_FILTER=m
CONFIG_IP_NF_NAT=m
CONFIG_IP_NF_MANGLE=m
CONFIG_IP_NF_TARGET_MASQUERADE=m
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=m

# NVMe drive temperatures via hwmon ("nvme" sensors entry)
CONFIG_NVME_HWMON=y

# x_tables extensions used by tailscale's iptables rules (iptables-nft goes
# through nft_compat for these): MARK (rev 2, "value/mask"), mark match,
# multiport, TCPMSS and comment.
CONFIG_NFT_COMPAT=m
CONFIG_NETFILTER_XT_TARGET_MARK=m
CONFIG_NETFILTER_XT_MATCH_MARK=m
CONFIG_NETFILTER_XT_MATCH_MULTIPORT=m
CONFIG_NETFILTER_XT_TARGET_TCPMSS=m
CONFIG_NETFILTER_XT_MATCH_COMMENT=m

# connmark / CONNMARK: tailscale's rp_filter workaround
#   -m connmark ! --mark 0x0/0xff0000 -j CONNMARK --restore-mark --nfmask ..
# xt_connmark.ko provides both the "connmark" match and the CONNMARK target
# (rev 2/3 are the ones with --nfmask/--ctmask) and selects NF_CONNTRACK_MARK.
CONFIG_NETFILTER_XT_CONNMARK=m
CONFIG_NF_CONNTRACK_MARK=y
CONFIG_NFT_COUNTER=m

# policy routing: tailscale installs ip rules + table 52 for fwmark routing
CONFIG_IP_ADVANCED_ROUTER=y
CONFIG_IP_MULTIPLE_TABLES=y
CONFIG_IPV6_MULTIPLE_TABLES=y
