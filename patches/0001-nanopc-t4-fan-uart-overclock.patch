+
+/*
+ * Overclock, after QiuSimons/R4S-OpenWrt 991-rockchip-rk3399-overclock-to-2.2-1.8-GHz:
+ * little cores up to 1.8 GHz, big cores up to 2.208 GHz.  The RK3399 PLL
+ * tables in drivers/clk/rockchip/clk-rk3399.c already carry both rates, and
+ * vdd_cpu_l (RK808 DCDC2, 0.75-1.35 V) / vdd_cpu_b (SYR827, 0.7125-1.5 V)
+ * can supply the voltages below.  Overclocking is unsupported by Rockchip
+ * and runs the SoC out of spec.
+ */
+&cluster0_opp {
+	opp06 {
+		opp-hz = /bits/ 64 <1608000000>;
+		opp-microvolt = <1200000 1200000 1250000>;
+	};
+
+	opp07 {
+		opp-hz = /bits/ 64 <1800000000>;
+		opp-microvolt = <1250000 1250000 1250000>;
+	};
+};
+
+&cluster1_opp {
+	opp08 {
+		opp-hz = /bits/ 64 <2016000000>;
+		opp-microvolt = <1250000 1250000 1275000>;
+	};
+
+	opp09 {
+		opp-hz = /bits/ 64 <2208000000>;
+		opp-microvolt = <1275000 1275000 1275000>;
+	};
+};
